# Local development settings, loaded by `langgraph dev`. `make dev-init` copies this to .env
# and fills in the generated values below; see docs/DEVELOPMENT.md for every key.

# --- Filled in by `make dev-init` ----------------------------------------------------------
# TOKEN_ENCRYPTION_KEY encrypts stored GitHub and Slack tokens: changing it loses them.
# DASHBOARD_JWT_SECRET signs the session cookie. ALLOWED_GITHUB_USERS (or ALLOWED_GITHUB_ORGS)
# may sign in; CONFIGURED_ADMINS see the Admin pages. Both default to your `gh` login.
TOKEN_ENCRYPTION_KEY=""
DASHBOARD_JWT_SECRET=""
ALLOWED_GITHUB_USERS=""
CONFIGURED_ADMINS=""

# --- Models --------------------------------------------------------------------------------
ANTHROPIC_API_KEY=""            # any one provider key, or a gateway key (docs/INSTALLATION.md)
# Without a key, OpenAI models run on your ChatGPT subscription through this token store.
# `make dev-init` points it at Deep Agents Code's store; `make chatgpt-login` signs in.
OPEN_SWE_OPENAI_OAUTH_TOKEN_FILE=""

# --- Sandboxes -----------------------------------------------------------------------------
# local runs the agent's commands on this machine, unisolated. langsmith (the deployed default)
# needs LANGSMITH_API_KEY and a dashboard reachable from the internet (make tunnel).
# `make dev` gives each checkout its own LOCAL_SANDBOX_ROOT_DIR under ~/.open-swe; setting it
# here applies to every worktree this file is copied to.
SANDBOX_TYPE="local"

# --- LangSmith -----------------------------------------------------------------------------
LANGSMITH_API_KEY=""            # also used for langsmith sandboxes and trace links
LANGSMITH_TRACING=""            # "true" traces runs to LangSmith
LANGSMITH_PROJECT=""

# --- GitHub App (optional locally: without one, sign-in uses the `gh` CLI) -----------------
GITHUB_APP_ID=""
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""
GITHUB_APP_PRIVATE_KEY=""       # one double-quoted line, \n between the PEM lines
GITHUB_WEBHOOK_SECRET=""
GITHUB_APP_INSTALLATION_ID=""

# --- Slack (optional) ----------------------------------------------------------------------
SLACK_BOT_TOKEN=""
SLACK_SIGNING_SECRET=""
SLACK_BOT_USER_ID=""
SLACK_BOT_USERNAME=""
SLACK_PUBLIC_BASE_URL=""        # your ngrok domain, https://<name>.ngrok-free.dev

# --- PostgreSQL ----------------------------------------------------------------------------
# Unset, `make dev` runs this checkout's own container. Setting it, even empty, overrides that
# in every worktree this file is copied to.
# POSTGRES_URI="postgresql://user:password@host:5432/db"
